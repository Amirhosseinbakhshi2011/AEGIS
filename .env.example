# AEGIS Environment Configuration
# Copy this file to .env and adjust the values for your environment.

# Application
AEGIS_ENV=development
AEGIS_DEBUG=false
AEGIS_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
AEGIS_API_PREFIX=/api/v1

# Optional shared API key for /scans endpoints (empty disables auth)
API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./aegis.db

# Redis / Celery (used for background scans; API falls back to in-process)
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Scan safety limits
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_SECONDS=120
MAX_REQUESTS_PER_SCAN=50
REQUEST_TIMEOUT_SECONDS=10
RATE_LIMIT_PER_MINUTE=30

# Domain verification
REQUIRE_DOMAIN_VERIFICATION=true
VERIFICATION_TXT_PREFIX=aegis-verification=
DKIM_SELECTORS=["selector1","selector2","google","default"]

# Optional external AI provider: openai | anthropic | (empty for local fallback)
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
