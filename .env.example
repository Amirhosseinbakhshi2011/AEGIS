# AEGIS Environment Configuration
AEGIS_ENV=development
AEGIS_DEBUG=true
AEGIS_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
AEGIS_API_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./aegis.db
REDIS_URL=redis://localhost:6379/0
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_SECONDS=120
MAX_REQUESTS_PER_SCAN=50
REQUEST_TIMEOUT_SECONDS=10
REQUIRE_DOMAIN_VERIFICATION=true
VERIFICATION_TXT_PREFIX=aegis-verification=
AI_PROVIDER=
LOG_LEVEL=INFO
LOG_FORMAT=json
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
